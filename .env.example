# Copie para .env (cp .env.example .env) e preencha. O .env NAO vai para o git.
# Tudo aqui e opcional: sem .env, a stack sobe com os defaults de desenvolvimento,
# e so as rotas de IA respondem 503 por falta de chave (RNF04).

# Gateway (RNF03): segredo HS256 do JWT, com pelo menos 32 caracteres.
JWT_SECRET=

# LLM (ai-service, Spring AI)
OPENAI_API_KEY=
# Opcional, para trocar de provedor sem mudar codigo:
# Gemini: OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Ollama: OPENAI_BASE_URL=http://host.docker.internal:11434
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
